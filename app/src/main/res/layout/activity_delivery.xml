<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Start a Delivery"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTextView">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingVertical="16dp">

            <!-- Location Section -->
            <TextView
                android:id="@+id/locationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textColor="@color/on_surface_medium"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Spinner
                android:id="@+id/spinnerFromLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_spinner"
                android:minHeight="48dp"
                android:popupBackground="@color/surface_variant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/locationLabel" />

            <!-- Path Section -->
            <TextView
                android:id="@+id/pathLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Path"
                android:textColor="@color/on_surface_medium"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/spinnerFromLocation" />

            <Spinner
                android:id="@+id/spinnerDestination"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_spinner"
                android:minHeight="48dp"
                android:popupBackground="@color/surface_variant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/pathLabel" />

            <!-- Item Section -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputItemLayout"
                style="@style/Widget.App.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="Item to deliver"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/spinnerDestination">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Live Feed Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleCamera"
                style="@style/Widget.App.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Show Live Feed"
                app:icon="@android:drawable/ic_menu_camera"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/inputItemLayout" />

            <!-- Camera Stream -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cameraCardView"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnToggleCamera">

                <WebView
                    android:id="@+id/cameraView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToOutline="true" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Obstacle Status -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/obstacleCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/success"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cameraCardView">

                <TextView
                    android:id="@+id/txtObstacle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="No obstacles detected"
                    android:textColor="@color/on_primary"
                    android:textSize="16sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Start Delivery Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartDelivery"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:text="Start Delivery"
                android:textSize="16sp"
                app:icon="@android:drawable/ic_media_play"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/obstacleCard" />

            <!-- OTP Verification Container - Initially Hidden -->
            <LinearLayout
                android:id="@+id/layoutOtp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnStartDelivery">

                <!-- OTP Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter One-Time Password (OTP)"
                    android:textSize="16sp"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="16dp" />

                <!-- OTP Input Fields Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <!-- 5 OTP Input Fields -->
                    <EditText
                        android:id="@+id/otpDigit1"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:background="@drawable/otp_box_background"
                        android:textColor="@color/on_surface"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:maxLength="1"
                        android:inputType="number"
                        android:imeOptions="actionNext"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/otpDigit2"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:background="@drawable/otp_box_background"
                        android:textColor="@color/on_surface"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:maxLength="1"
                        android:inputType="number"
                        android:imeOptions="actionNext"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/otpDigit3"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:background="@drawable/otp_box_background"
                        android:textColor="@color/on_surface"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:maxLength="1"
                        android:inputType="number"
                        android:imeOptions="actionNext"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/otpDigit4"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:background="@drawable/otp_box_background"
                        android:textColor="@color/on_surface"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:maxLength="1"
                        android:inputType="number"
                        android:imeOptions="actionNext"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/otpDigit5"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:background="@drawable/otp_box_background"
                        android:textColor="@color/on_surface"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:maxLength="1"
                        android:inputType="number"
                        android:imeOptions="actionDone"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <!-- OTP Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <!-- Paste Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPasteOtp"
                        style="@style/Widget.App.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Paste"
                        android:layout_marginEnd="8dp" />

                    <!-- Verify Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerifyOtp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verify" />
                </LinearLayout>

                <!-- OTP Status Message -->
                <TextView
                    android:id="@+id/txtOtpStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/error"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutOtp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>