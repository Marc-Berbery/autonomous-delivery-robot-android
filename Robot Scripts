def parse_delivery_message(payload):
    """Parse the delivery message in format 'email;jsonstring'."""
    # Special case for "delivered" message
    if payload == "delivered":
        print("Received delivery completion message")
        return "RETURN_SIGNAL", None
    
    try:
        # Split by the first semicolon
        parts = payload.split(';', 1)
        if len(parts) != 2:
            raise ValueError("Invalid message format. Expected 'email;jsonstring'")
            
        email = parts[0].strip()
        json_str = parts[1].strip()
        
        # Validate email format (basic check)
        if '@' not in email or '.' not in email:
            raise ValueError(f"Invalid email address format: {email}")
            
        # Parse the JSON
        instruction_data = json.loads(json_str)
        
        return email, instruction_data
    except json.JSONDecodeError:
        print("Error: Invalid JSON format in instruction set")
        return None, None
    except Exception as e:
        print(f"Error parsing delivery message: {e}")
        return None, None

