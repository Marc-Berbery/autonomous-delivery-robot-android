        left_speed = speed - 3  # Apply a small initial adjustment to left motor
        print(f"Applying slight right drift compensation for turbo mode")
    else:
        # Normal mode - start with equal speeds
        right_speed = speed
        left_speed = speed
    
    # Apply the speeds
    pwm_right.ChangeDutyCycle(right_speed)
    pwm_left.ChangeDutyCycle(left_speed)
    
    # Update states
    right_motors_state = {"forward": GPIO.HIGH, "backward": GPIO.LOW, "enabled": True}
    left_motors_state = {"forward": GPIO.HIGH, "backward": GPIO.LOW, "enabled": True}
