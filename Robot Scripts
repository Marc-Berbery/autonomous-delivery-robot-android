        correction_threshold = 0.3
        
        # Apply drift compensation to the correction value
        if abs(current_angle) < 0.8:  # Small drift, don't correct
            return
    
    # Only apply corrections if they're significant enough
    if abs(correction) > correction_threshold:
        # For turbo mode or near-max speed, we can only reduce speed on one side
        if is_max_speed:
            # More aggressive reduction for higher angle deviation
            reduction_factor = min(40, abs(correction) * 4.0)  # Scale with angle, max 40% reduction
            
            if correction > 0:  # Drifting right, need to turn left
                # Keep right at max, reduce left
                right_speed = base_speed
                left_speed = max(60, base_speed - reduction_factor)
            else:  # Drifting left, need to turn right
                # Reduce right, keep left at max
                right_speed = max(60, base_speed - reduction_factor)
                left_speed = base_speed
        else:
            # Not in turbo mode, use the balanced approach
            correction_multiplier = 1.8
            
            if active_command == "Backward":
                correction *= 0.75  # Reduce correction strength for backward
            
            if correction > 0:  # Drifting right, need to turn left
                right_boost = min(100 - base_speed, abs(correction) * correction_multiplier * 0.25)
                right_speed = base_speed + right_boost
                left_speed = max(65, base_speed - abs(correction) * correction_multiplier * 0.25)
            else:  # Drifting left, need to turn right
                left_boost = min(100 - base_speed, abs(correction) * correction_multiplier * 0.25)
                right_speed = max(65, base_speed - abs(correction) * correction_multiplier * 0.25)
                left_speed = base_speed + left_boost
        
        # Apply speeds
        pwm_right.ChangeDutyCycle(right_speed)
        pwm_left.ChangeDutyCycle(left_speed)
        
        if DEBUG_MODE:
            print(f"CORRECTION - Direction: {active_command}, Angle: {current_angle:.2f}°, "
                  f"Speeds: R={right_speed:.1f}%, L={left_speed:.1f}% {'[TURBO]' if is_max_speed else ''}")
    elif DEBUG_MODE and abs(correction) > 0.1:
        print(f"MINOR CORRECTION NEEDED (not applied) - Angle: {current_angle:.2f}°, Correction: {correction:.2f}")

