def forward(speed=None, is_return_journey=False):
    """Move forward with gyroscope-based straight-line correction and turbo mode handling."""
    global right_motors_state, left_motors_state, active_command, KP, KI, KD
    
    if speed is None:
        speed = current_speed
    
    # Store original PID values if this is a return journey
    original_KP, original_KI, original_KD = None, None, None
    if is_return_journey:
        # Save original values
        original_KP, original_KI, original_KD = KP, KI, KD
        
        # Apply more aggressive correction during return journeys
        KP = 0.8  # Increase proportional gain
        KI = 0.15 # Integral gain
        KD = 0.2  # Increase derivative gain
        print("Using enhanced PID values for return journey forward movement")
    
    # Reset angle tracking when starting forward movement
    reset_angle()
    
    # MODIFIED: Switched pin settings to match mobile app expectations
    # Right motors backward
    GPIO.output(IN1, GPIO.LOW)
    GPIO.output(IN2, GPIO.HIGH)
    # Left motors backward
    GPIO.output(IN3, GPIO.LOW)
    GPIO.output(IN4, GPIO.HIGH)
    
