def read_raw_gyro_data():
    """Read raw gyroscope data from the sensor."""
    try:
        # Read 2 bytes from each axis register and convert to signed 16-bit value
        x = bus.read_word_data(GYRO_ADDR, GYRO_REG_GYRO_X)
        y = bus.read_word_data(GYRO_ADDR, GYRO_REG_GYRO_Y)
        z = bus.read_word_data(GYRO_ADDR, GYRO_REG_GYRO_Z)
        
        # Convert from big-endian to little-endian and handle sign
        x = ((x & 0xFF) << 8) | ((x >> 8) & 0xFF)
        y = ((y & 0xFF) << 8) | ((y >> 8) & 0xFF)
        z = ((z & 0xFF) << 8) | ((z >> 8) & 0xFF)
        
        # Convert to signed values
        if x > 32767:
            x -= 65536
        if y > 32767:
            y -= 65536
        if z > 32767:
            z -= 65536
            
        return x, y, z
        
    except Exception as e:
        print(f"Error reading gyroscope data: {e}")
        return 0, 0, 0

def get_gyro_data():
    """Get calibrated gyroscope data in degrees per second."""
    x, y, z = read_raw_gyro_data()
    
    # Apply calibration offsets
    x = (x - gyro_x_offset) / GYRO_SCALE
    y = (y - gyro_y_offset) / GYRO_SCALE
    z = (z - gyro_z_offset) / GYRO_SCALE
    
    if DEBUG_MODE:
        current_time = time.time()
        global last_debug_time
        if current_time - last_debug_time >= DEBUG_INTERVAL:
            print(f"GYRO DATA - X: {x:.2f}°/s, Y: {y:.2f}°/s, Z: {z:.2f}°/s, Angle: {current_angle:.2f}°")
            last_debug_time = current_time
    
    return x, y, z

def update_angle():
    """Update the current angle based on gyroscope data with better drift handling."""
    global current_angle, last_gyro_time
    
    current_time = time.time()
    
    # Skip if this is the first update
    if last_gyro_time == 0:
        last_gyro_time = current_time
        return 0
    
    # Calculate time delta in seconds
    dt = current_time - last_gyro_time
    last_gyro_time = current_time
    
    # Read gyroscope data (degrees per second)
    _, _, z = get_gyro_data()  # We only need z-axis for yaw (rotation in horizontal plane)
    
    # Apply a more aggressive threshold filter to deal with inconsistent drift
    # This ignores small rotational values that are likely just noise or drift
    DRIFT_THRESHOLD = 0.3  # Adjust this value based on testing
    if abs(z) < DRIFT_THRESHOLD:
        z = 0.0  # Zero out small values
    
    # Update angle by integrating gyro rate over time
    angle_change = z * dt
    current_angle += angle_change
    
    # Normalize to -180 to +180 degrees
    if current_angle > 180:
        current_angle -= 360
    elif current_angle < -180:
        current_angle += 360
        
    return angle_change

def reset_angle():
    """Reset the current angle to zero."""
    global current_angle, integral, last_error
    current_angle = 0.0
    integral = 0.0
    last_error = 0.0
    
    if DEBUG_MODE:
        print("ANGLE RESET - Gyroscope angle reset to zero")

def calculate_steering_correction():
    """Calculate steering correction using PID control with improved parameters for high speeds."""
    global integral, last_error, steering_correction, current_speed, KP, KI, KD
    
    # Current error is the current angle (should be 0 for straight line)
    error = current_angle
    
    # Adjust PID parameters for high speed operation (turbo mode)
    # In high speeds, we need more responsive correction
    original_KP, original_KI, original_KD = KP, KI, KD
    
    if current_speed >= 95:  # Turbo or near-turbo speed
        # More aggressive P and D values for faster response at high speed
        KP = 0.9  # Higher P gain for faster response (was 0.5)
        KI = 0.08 # Lower I gain to reduce oscillation (was 0.1)
        KD = 0.3  # Higher D gain for faster response to changes (was 0.1)
    
    # Calculate integral term with anti-windup
    integral += error
    integral = max(-40, min(40, integral))  # Limit integral to prevent excessive buildup
    
    # Calculate derivative term
    derivative = error - last_error
    last_error = error
    
    # PID formula
    steering_correction = KP * error + KI * integral + KD * derivative
    
    # Limit correction to reasonable values
    steering_correction = max(-40, min(40, steering_correction))
    
    # Debug info but only for significant corrections
    if DEBUG_MODE and abs(error) > 1.0:
        print(f"PID CALCULATION - Error: {error:.2f}°, P: {KP * error:.2f}, " 
              f"I: {KI * integral:.2f}, D: {KD * derivative:.2f}, " 
              f"Correction: {steering_correction:.2f} {'[TURBO]' if current_speed >= 95 else ''}")
    
    # Restore original PID values
    KP, KI, KD = original_KP, original_KI, original_KD
    
    return steering_correction

