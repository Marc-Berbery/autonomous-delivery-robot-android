def calibrate_gyroscope():
    """Calibrate the gyroscope by calculating offsets."""
    global gyro_x_offset, gyro_y_offset, gyro_z_offset
    
    print("Calibrating gyroscope... Keep the device still")
    
    # More samples for better calibration
    samples = 300  # Increased from default
    x_sum = 0
    y_sum = 0
    z_sum = 0
    
    # Collect samples
    for _ in range(samples):
        x, y, z = read_raw_gyro_data()
        x_sum += x
        y_sum += y
        z_sum += z
        time.sleep(0.01)  # Short delay between readings
    
    # Calculate average offsets
    gyro_x_offset = x_sum / samples
    gyro_y_offset = y_sum / samples
    gyro_z_offset = z_sum / samples
    
    print(f"Gyroscope calibration complete. Offsets: X={gyro_x_offset}, Y={gyro_y_offset}, Z={gyro_z_offset}")


def check_recalibration():
