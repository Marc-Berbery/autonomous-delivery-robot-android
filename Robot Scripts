def create_return_instructions(original_instructions):
    """Create a return instruction set by reversing and flipping directions."""
    # Start with an empty instruction set
    return_instructions = []
    
    # Reverse the original instructions and flip directions
    for instruction in reversed(original_instructions):
        command = instruction.get('command', '').lower()
        duration = float(instruction.get('duration', 0))
        
        # Create a new instruction with flipped direction if needed
        if command == 'forward':
            new_command = 'forward'  # Keep forward as forward for simplicity
        elif command == 'backward':
            new_command = 'backward'  # Keep backward as backward
        elif command == 'right':
            new_command = 'left'  # Flip right to left
        elif command == 'left':
            new_command = 'right'  # Flip left to right
        elif command == 'stop':
            new_command = 'stop'  # Keep stop as stop
        else:
            # Skip unknown commands
            continue
            
        # Add the reversed instruction
        return_instructions.append({
            "command": new_command,
            "duration": duration
        })
    
    return return_instructions

def execute_180_degree_turn():
    """Execute a 180-degree turn using gyroscope to measure the angle."""
    global delivery_stop_flag, current_angle, ultrasonic_monitoring
    
    # Temporarily pause ultrasonic monitoring to avoid I2C bus contention
    original_ultrasonic_state = ultrasonic_monitoring
    ultrasonic_monitoring = False
