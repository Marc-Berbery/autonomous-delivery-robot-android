# Add function to monitor ultrasonic sensors
def monitor_ultrasonic_sensors():
    """Background loop to monitor ultrasonic sensors for obstacles."""
    global delivery_in_progress, delivery_stop_flag, mqtt_client, ultrasonic_monitoring
    
    print("Ultrasonic sensor monitoring thread started")
    ultrasonic_monitoring = True
    
    try:
        while True:  # Keep the thread running even when monitoring is paused
            # Only actively check for obstacles when monitoring is enabled
            if ultrasonic_monitoring and delivery_in_progress and not delivery_stop_flag:
                # Read distances from all three sensors
                front_dist = read_ultrasonic_distance(FRONT_ULTRASONIC_PIN)
                left_dist = read_ultrasonic_distance(LEFT_ULTRASONIC_PIN)
                right_dist = read_ultrasonic_distance(RIGHT_ULTRASONIC_PIN)
                
                # Check if any sensor detects an obstacle within threshold
                obstacle_detected = (
                    front_dist < OBSTACLE_THRESHOLD or 
                    left_dist < OBSTACLE_THRESHOLD or 
                    right_dist < OBSTACLE_THRESHOLD
                )
                
                if obstacle_detected:
                    # Create the sensor message
                    sensor_msg = f"sensor;obstacle;front:{front_dist}cm;left:{left_dist}cm;right:{right_dist}cm"
                    
                    # Publish to sensor topic
                    if mqtt_client:
                        mqtt_client.publish(SENSOR_TOPIC, sensor_msg)
                        print(f"Obstacle detected: {sensor_msg}")
                        
                        # Send the delivery abort message
                        mqtt_client.publish("/khanfar/delivery", "delivery aborted due obstacle")
                        print("Published delivery abort message")
                    
                    # Set the stop flag to interrupt the delivery
                    delivery_stop_flag = True
                    
                    # Stop the motors
                    stop()
            
            # Sleep to avoid excessive CPU usage and sensor readings
            time.sleep(0.2)
            
    except Exception as e:
        print(f"Error in ultrasonic sensor monitoring loop: {e}")
    finally:
        ultrasonic_monitoring = False
        print("Ultrasonic sensor monitoring stopped")

