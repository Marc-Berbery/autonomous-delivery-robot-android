                continue
            
            # Wait for the specified duration, checking for obstacles every 0.1 seconds
            elapsed = 0
            while elapsed < duration and not delivery_stop_flag:
                time.sleep(0.1)
                elapsed += 0.1
            
            # If we didn't complete the duration due to a stop flag, break the loop
            if delivery_stop_flag:
                # Add this condition to check if it was due to an obstacle
                if obstacleDetected:
                    print("Return journey stopped due to obstacle detection")
                else:
                    print("Return journey stopped by manual override")
                    
                print("Return journey interrupted")
                break
        
        # Stop motors after completing all instructions
        stop()
        
        # SECOND 180-DEGREE TURN: Turn around to face original direction
        if not delivery_stop_flag:
            print("\nExecuting second 180-degree turn to face original direction...")
            
            # Pause briefly between movements
            time.sleep(0.5)
            
            # Execute gyroscope-based 180-degree turn
            execute_180_degree_turn()
        
        # Send "arrived" message on status topic only after final turn
        if not delivery_stop_flag:
            print("Return journey completed! Sending 'arrived' status.")
            client.publish("/khanfar/status", "arrived")
        
    except Exception as e:
        print(f"Error executing return journey: {str(e)}")
    finally:
        # Reset delivery flags
        delivery_in_progress = False
        delivery_stop_flag = False
        
        # Reset speed to original
        current_speed = original_speed

# Main function
def main():
    global mqtt_client  # Make the client accessible
    
    try:
        print("Starting main function...")
        
        # Initialize gyroscope
        print("Initializing gyroscope...")
        init_gyroscope()
        # Initialize buzzer
        print("Initializing buzzer...")
        init_buzzer()
        # Initialize ultrasonic sensors
        print("Initializing ultrasonic sensors...")
        init_ultrasonic_sensors()

        # Create MQTT client instance
        print("Creating MQTT client...")
        client = mqtt.Client()
        mqtt_client = client  # Store client in global variable
        
        # Assign callback functions
        print("Assigning callbacks...")
        client.on_connect = on_connect
        client.on_message = on_message
        client.on_disconnect = on_disconnect
        
        # Set will message (last testament)
        print("Setting will message...")
        client.will_set("/khanfar/control/status", "Car offline", qos=1, retain=True)
        
        # Make sure motors are stopped initially
        print("Stopping motors initially...")
        stop()
        
        # Connect to the broker
        print(f"Connecting to MQTT broker at {broker_address}:{broker_port}...")
        try:
            client.connect(broker_address, broker_port, 60)
            print("Connection attempt made")
        except Exception as e:
            print(f"Error connecting to MQTT broker: {e}")
            return
        
        # Publish online status
        try:
            client.publish("/khanfar/control/status", "Car online", qos=1, retain=True)
            print("Published online status")
        except Exception as e:
            print(f"Error publishing status: {e}")
        
        # Start gyroscope update in a separate thread
        print("Starting gyroscope update thread...")
        gyro_thread = threading.Thread(target=gyroscope_update_loop, args=(client,))
        gyro_thread.daemon = True  # Thread will exit when main thread exits
        gyro_thread.start()
        print("Gyroscope thread started")
        
        # Start package monitoring in a separate thread
        print("Starting package monitoring thread...")
        package_thread = threading.Thread(target=monitor_package)
        package_thread.daemon = True
        package_thread.start()
        
        # Start ultrasonic sensor monitoring in a separate thread
        print("Starting ultrasonic sensor monitoring thread...")
        ultrasonic_thread = threading.Thread(target=monitor_ultrasonic_sensors)
        ultrasonic_thread.daemon = True
        ultrasonic_thread.start()

        # Start network loop
        print("Starting MQTT subscription. Press Ctrl+C to exit.")
        print(f"Current speed setting: {current_speed}% (Turbo mode: {'ON' if turbo_mode else 'OFF'})")
        print(f"Debug mode: {'ON' if DEBUG_MODE else 'OFF'}")
        print("Car control, path recording, delivery execution, and gyroscope straight-line correction are active")
        print("IR sensor package monitoring is active")
        print("Ultrasonic sensor obstacle detection is active")

        print("Starting MQTT loop_forever()...")
        client.loop_forever()
        
    except KeyboardInterrupt:
        print("\nExiting program due to keyboard interrupt")
        stop()
        if mqtt_client:
            mqtt_client.publish("/khanfar/control/status", "Car offline", qos=1, retain=True)
            mqtt_client.disconnect()
            mqtt_client.loop_stop()
        
    except Exception as e:
        print(f"Error in main function: {e}")
        import traceback
        traceback.print_exc()
        
    finally:
        # Add ultrasonic monitoring flag to ensure thread stops
        global ultrasonic_monitoring
        ultrasonic_monitoring = False
        # Clean up
        print("Cleaning up resources...")
        stop()
        pwm_right.stop()
        pwm_left.stop()
        GPIO.cleanup()
        print("Program stopped and GPIO cleaned up")

# Fix the if __name__ syntax
if __name__ == "__main__":
    print("Starting main execution...")
    main()
    print("Script execution completed")
