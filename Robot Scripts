def on_message(client, userdata, msg):
    """Called when a message is received from the broker"""
    global delivery_stop_flag, delivery_in_progress, obstacleDetected, last_delivery_instructions
    
    topic = msg.topic
    payload = msg.payload.decode("utf-8").strip()
    
    # Don't print large payloads (like JSON instruction sets)
    if len(payload) > 50:
        print(f"Message received on topic {topic}: {payload[:50]}...")  # Print first 50 chars of payload
    else:
        print(f"Message received on topic {topic}: {payload}")
    
    if topic == SENSOR_TOPIC:
        # Process sensor data
        if "sensor" in payload and "cm" in payload:
            print(f"Obstacle detected: {payload}")
            obstacleDetected = True
            
            # Set delivery stop flag if a delivery is in progress
            if delivery_in_progress:
                delivery_stop_flag = True
                print("Delivery stopped due to obstacle detection")
            
            # Send stop signal
            stop()
        else:
            obstacleDetected = False
    
    elif topic == "/khanfar/control":
        # Same control logic as before...
        payload_lower = payload.lower()
        is_movement_command = payload_lower in ["forward", "backward", "right", "left"]
        
        if is_calibrating and is_movement_command:
            # If calibrating, don't process movement commands, but notify the user
            print(f"Ignoring command '{payload}' - calibration in progress")
            client.publish("/khanfar/status", "command_ignored_calibrating")
            return
        
        # Process movement commands
        if payload_lower == "forward":
            forward()
        elif payload_lower == "backward":
            backward()
        elif payload_lower == "right":
            turn_right()
        elif payload_lower == "left":
            turn_left()
        elif payload_lower == "stop":
            stop()
            # If a delivery is in progress, set the stop flag
            if delivery_in_progress:
                delivery_stop_flag = True
                print("Delivery manually stopped")
        elif payload_lower == "turbo on":
            set_turbo_mode(True)
        elif payload_lower == "turbo off":
            set_turbo_mode(False)
            
        # Handle path recording
        if payload_lower in ["start", "end", "forward", "backward", "right", "left", "stop"]:
            handle_path_recording(client, payload_lower)
        
    elif topic == "/khanfar/delivery":
        # Parse the message to check if it's a delivery or special command
        result, instruction_data = parse_delivery_message(payload)
        
        # Handle "delivered" message - start return journey
        if result == "RETURN_SIGNAL":
            if delivery_in_progress:
                print("Cannot start return journey - delivery already in progress")
                return
                
            if last_delivery_instructions is None:
                print("No previous delivery instructions found for return journey")
                return
                
            print("Starting return journey in 10 seconds...")
            
            # Define a thread function to handle the waiting and return journey
            def return_journey_thread():
                # Wait 10 seconds
                time.sleep(10)
                
                # Create return instructions
                return_instructions = create_return_instructions(last_delivery_instructions)
                return_instruction_set = {'instruction_set': return_instructions}
                
                print("Now executing return journey...")
                execute_return_journey(return_instruction_set, client)
            
            # Start the delayed return journey in a separate thread
            return_thread = threading.Thread(target=return_journey_thread)
            return_thread.daemon = True
            return_thread.start()
            return
            
        # Regular delivery instruction
        if delivery_in_progress:
            print("Ignoring new delivery request: delivery already in progress")
            return
            
        if result is None or instruction_data is None:
            print("Failed to parse delivery message")
            return
            
        # Store the instruction set for potential return journey (if it's an email)
        if result != "RETURN_SIGNAL" and 'instruction_set' in instruction_data:
            last_delivery_instructions = instruction_data['instruction_set']
            
        print(f"Received delivery instructions for: {result}")
        
        # Start delivery in a new thread so it doesn't block MQTT callbacks
        delivery_thread = threading.Thread(
            target=execute_instruction_set,
            args=(instruction_data, result if result != "RETURN_SIGNAL" else None)
        )
        delivery_thread.daemon = True
        delivery_thread.start()

