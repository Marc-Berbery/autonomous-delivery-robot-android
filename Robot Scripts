    # Allow a moment for the monitoring thread to recognize the state change
    time.sleep(0.2)
    
    reset_angle()
    print("\nExecuting 180-degree turn...")
    
    # Start turning right
    turn_right()
    
    # Track the angle until we reach the target
    start_time = time.time()
    target_reached = False
    
    while not target_reached and not delivery_stop_flag:
        try:
            # Update angle
            update_angle()
            
            # Check if we've reached target
            if abs(current_angle) >= 165:
                target_reached = True
            
            # Safety timeout after 5 seconds
            if time.time() - start_time > 5:
                print("Timeout reached - stopping 180-degree turn")
                break
                
            time.sleep(0.01)  # Short sleep to reduce CPU usage
        except Exception as e:
            print(f"Error during turn angle measurement: {e}")
            # Continue trying despite errors
            time.sleep(0.05)
    
    # Stop turning
    stop()
    
    # Calculate final time
    final_time = time.time() - start_time
    final_angle = current_angle
    
    print(f"180-degree turn completed in {final_time:.2f} seconds (final angle: {final_angle:.2f}°)")
    
    # Allow gyroscope readings to stabilize before continuing
    time.sleep(0.3)
    
    # Restore ultrasonic monitoring to its original state
    ultrasonic_monitoring = original_ultrasonic_state
    print(f"Ultrasonic monitoring restored to: {'active' if original_ultrasonic_state else 'inactive'}")
    
